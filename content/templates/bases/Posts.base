filters:
  and:
    - publish == true
    - file.hasTag("post", "trip")
formulas:
  title: if(file.properties.title, link( file.name, file.properties.title), link(file.name))
  Formatted Date: date.format("MMMM D, YYYY")
properties:
  formula.title:
    displayName: Posts
  note.date:
    displayName: Date
views:
  - type: cards
    name: 6 Posts
    order:
      - formula.title
      - formula.Formatted Date
    sort:
      - property: date
        direction: DESC
    limit: 6
    image: note.cover
    imageAspectRatio: 0.65
    imageFit: ""
    cardSize: 280
  - type: cards
    name: All posts
    order:
      - formula.title
      - formula.Formatted Date
    sort:
      - property: date
        direction: DESC
    image: note.cover
    imageAspectRatio: 0.65
    imageFit: ""
    cardSize: 280
