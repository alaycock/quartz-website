{
  "name": "@quartz-community/explorer",
  "version": "1.0.0",
  "description": "Vendored @quartz-community/explorer 1.0.0 so the site can patch it. Explorer component for Quartz - navigate your content with an interactive file tree.",
  "type": "module",
  "license": "MIT",
  "author": "Quartz Community",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./types": {
      "import": "./dist/types.js"
    },
    "./components": {
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "sideEffects": false,
  "dependencies": {
    "@quartz-community/types": "^1.0.0",
    "@quartz-community/utils": "^1.0.0"
  },
  "quartz": {
    "name": "explorer",
    "displayName": "Explorer",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "folderDefaultState": "collapsed",
      "folderClickBehavior": "link",
      "useSavedState": true
    },
    "components": {
      "Explorer": {
        "displayName": "Explorer",
        "defaultPosition": "left",
        "defaultPriority": 50
      }
    },
    "optionSchema": {
      "title": {
        "type": "string"
      },
      "folderDefaultState": {
        "type": "enum",
        "values": [
          "collapsed",
          "open"
        ]
      },
      "folderClickBehavior": {
        "type": "enum",
        "values": [
          "collapse",
          "link"
        ]
      },
      "useSavedState": {
        "type": "boolean"
      }
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "private": true
}
