{
  "name": "@quartz-community/content-index",
  "version": "1.0.0",
  "description": "Vendored @quartz-community/content-index 1.0.0, reconstructed from its published source maps, so the site can patch it.",
  "type": "module",
  "license": "MIT",
  "author": "Quartz Community",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "sideEffects": false,
  "dependencies": {
    "@quartz-community/types": "^1.0.0",
    "@quartz-community/utils": "^1.0.0"
  },
  "quartz": {
    "name": "content-index",
    "displayName": "Content Index",
    "category": "emitter",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "enableSiteMap": true,
      "enableRSS": true,
      "rssLimit": 10,
      "rssFullHtml": false,
      "rssSlug": "index",
      "includeEmptyFiles": true
    },
    "optionSchema": {
      "enableSiteMap": {
        "type": "boolean"
      },
      "enableRSS": {
        "type": "boolean"
      },
      "rssLimit": {
        "type": "number"
      },
      "rssFullHtml": {
        "type": "boolean"
      },
      "rssSlug": {
        "type": "string"
      },
      "includeEmptyFiles": {
        "type": "boolean"
      }
    }
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "private": true
}
